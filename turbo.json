{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ALTORA_TEST_HARNESS",
        "AUTH_SECRET",
        "DATABASE_URL",
        "DIRECT_URL",
        "NODE_ENV"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "env": [
        "ALTORA_TEST_HARNESS",
        "AUTH_SECRET",
        "DATABASE_URL",
        "DIRECT_URL",
        "NODE_ENV"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build",
        "^check-types"
      ],
      "env": [
        "AUTH_SECRET",
        "DATABASE_URL",
        "DIRECT_URL",
        "NODE_ENV"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "AUTH_SECRET",
        "DATABASE_URL",
        "DIRECT_URL",
        "NODE_ENV",
        "PORT"
      ]
    }
  },
  "globalEnv": [
    "ALLOW_PRODUCTION_SEED",
    "SEED_PASSWORD",
    "DIRECT_URL"
  ]
}
