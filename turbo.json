{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["AUTH_SECRET", "DATABASE_URL", "NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["AUTH_SECRET", "DATABASE_URL", "NODE_ENV"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "env": ["AUTH_SECRET", "DATABASE_URL", "NODE_ENV"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["AUTH_SECRET", "DATABASE_URL", "NODE_ENV", "PORT"]
    }
  }
}
