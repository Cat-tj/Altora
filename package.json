{
  "name": "altora",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "npm run test:contracts && npm run test:versions && npm run test:repository",
    "test:contracts": "node --test packages/*/src/*.test.mjs",
    "test:versions": "node --test scripts/check-product-versions.test.mjs",
    "test:repository": "node --test scripts/check-repository-health.test.mjs",
    "check:repository": "node scripts/check-repository-health.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e:market": "playwright test",
    "dev:landing": "npm run dev --workspace=@altora/landing",
    "dev:resto": "npm run dev --workspace=@altora/resto",
    "dev:market": "npm run dev --workspace=@altora/market",
    "dev:admin": "npm run dev --workspace=@altora/admin"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "overrides": {
    "next": "16.2.12"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.8.0 <12"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "next": "16.2.12"
  }
}
